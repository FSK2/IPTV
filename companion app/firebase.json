{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.exe",
      "*.apk",
      "*.bat",
      "*.pdb",
      "code.html",
      "DESIGN.md"
    ],
    "headers": [
      {
        "source": "**/*.@(zip|exe|dmg|apk)",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment"
          },
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          }
        ]
      }
    ]
  }
}
